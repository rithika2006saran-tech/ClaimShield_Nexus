# Copy to .env — never commit real secrets.
POSTGRES_USER=claimshield
POSTGRES_PASSWORD=claimshield
POSTGRES_DB=claimshield
POSTGRES_PORT=5432
ES_PORT=9200
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Local (non-Docker) development
DATABASE_URL=postgresql://postgres.rzayngmmgfgkrpqcrvhd:G+bZKwD?RW?2$.E@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
ELASTIC_API_KEY=
LLM_API_KEY=
DATA_DIR=./data

# Second Brain backend: auto | elasticsearch | local
# auto = use Elasticsearch if reachable, otherwise the in-process fallback
SECOND_BRAIN_BACKEND=auto

# LLM provider abstraction: none (deterministic, default) | anthropic | openai
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
